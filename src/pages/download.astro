---
import Layout from '../layouts/Layout.astro';
import WindowsWaitlist from '../components/WindowsWaitlist';

const title = 'Download Uncached — free for macOS and Linux';
const description =
  'Download the latest Uncached build for macOS or Linux. The free tier scans your workspaces and moves regenerable build artifacts to Trash.';
const keywords =
  'download uncached, disk cleanup app download, node_modules cleaner download, macos build cache cleaner, linux developer disk cleaner';
---

<Layout title={title} description={description} keywords={keywords} >
  <main class="flex-1">
    <section class="mx-auto max-w-3xl px-6 pb-8 pt-16 text-center sm:pt-24">
      <h1
        class="mx-auto max-w-3xl text-pretty text-[2rem] font-semibold leading-[1.1] tracking-tighter text-text-primary sm:text-balance sm:text-5xl sm:leading-[1.05]"
      >
        Get your disk back.
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-pretty text-base leading-7 text-text-secondary sm:text-lg">
        Free, no account, no upload. Uncached scans locally and moves what you select to Trash.
      </p>
      <p class="mt-4 font-mono text-xs text-text-muted">
        Version <span id="latest-version" class="inline-block h-3 w-10 animate-pulse rounded bg-raised align-middle" aria-label="Loading"></span>
      </p>
    </section>

    <section class="mx-auto w-full max-w-3xl px-6 pb-6">
      <div
        id="primary-skeleton"
        class="flex flex-col items-center rounded-2xl border border-border-theme bg-surface p-7"
        aria-hidden="true"
      >
        <span class="h-7 w-56 animate-pulse rounded-md bg-raised"></span>
        <span class="mt-2 h-3.5 w-48 animate-pulse rounded bg-raised"></span>
        <span class="mt-5 h-11 w-44 animate-pulse rounded-xl bg-raised"></span>
      </div>

      <div id="primary-download" class="hidden">
        <a
          id="primary-download-link"
          href="#"
          class="reveal flex flex-col items-center rounded-2xl border border-accent bg-surface p-7 text-center transition-colors hover:bg-raised"
        >
          <span class="text-lg font-semibold text-text-primary" id="primary-download-label" />
          <span class="mt-1 font-mono text-[11px] text-text-muted" id="primary-download-detail" />
          <span class="mt-5 inline-flex rounded-xl bg-accent px-6 py-3 text-sm font-semibold text-accent-text">
            Download for free
          </span>
        </a>
      </div>

      <p
        id="download-status"
        role="status"
        aria-live="polite"
        class="sr-only text-center text-sm text-text-muted"
      >
        Looking up the latest release…
      </p>
    </section>

    <section class="mx-auto w-full max-w-3xl px-6 pb-14">
      <h2 class="mb-4 font-mono text-[11px] uppercase tracking-wider text-text-muted">
        All platforms
      </h2>
      <ul id="download-list" class="flex flex-col gap-3" aria-busy="true">
        {[0, 1, 2].map(() => (
          <li class="flex items-center justify-between gap-4 rounded-xl border border-border-theme bg-surface px-5 py-4" aria-hidden="true">
            <span class="flex flex-col gap-2">
              <span class="h-3.5 w-52 animate-pulse rounded bg-raised"></span>
              <span class="h-3 w-40 animate-pulse rounded bg-raised"></span>
            </span>
            <span class="h-3 w-16 animate-pulse rounded bg-raised"></span>
          </li>
        ))}
      </ul>
      <div id="windows" class="mt-3 rounded-xl border border-dashed border-border-theme bg-surface px-5 py-4">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <span class="text-sm font-semibold text-text-primary">Windows — soon</span>
          <span class="font-mono text-[11px] text-text-muted">Through the Microsoft Store</span>
        </div>
        <p class="mt-1 text-xs leading-relaxed text-text-muted">
          Leave an email and you get one message when it ships.
        </p>
        <div class="mt-3">
          <WindowsWaitlist client:visible />
        </div>
      </div>
    </section>

    <section class="mx-auto w-full max-w-3xl px-6 pb-16">
      <div class="rounded-2xl border border-border-theme bg-surface p-6">
        <h2 class="text-sm font-semibold text-text-primary">What is in this release</h2>
        <div id="release-notes-skeleton" class="mt-3 flex flex-col gap-2" aria-hidden="true">
          <span class="h-3 w-full animate-pulse rounded bg-raised"></span>
          <span class="h-3 w-11/12 animate-pulse rounded bg-raised"></span>
          <span class="h-3 w-2/3 animate-pulse rounded bg-raised"></span>
        </div>
        <p id="release-notes" class="reveal mt-3 hidden whitespace-pre-line text-xs leading-relaxed text-text-muted" />
      </div>
    </section>
  </main>
</Layout>

<script>
  interface Download {
    key: string;
    os: string;
    label: string;
    detail: string;
    url: string;
    filename: string;
  }

  interface Manifest {
    version: string;
    notes: string;
    pubDate: string | null;
    downloads: Download[];
  }

  /**
   * `navigator.userAgentData.platform` is not in every browser, so the classic
   * string is the fallback. Apple ships an identical UA for both Mac
   * architectures, so Silicon is inferred from the WebGL renderer instead.
   */
  function detectPlatformKey(): string | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return 'windows-x86_64';
    if (/Linux/i.test(ua) && !/Android/i.test(ua)) return 'linux-x86_64';
    if (!/Mac/i.test(ua)) return null;
    return isAppleSilicon() ? 'darwin-aarch64' : 'darwin-x86_64';
  }

  function isAppleSilicon(): boolean {
    try {
      const canvas = document.createElement('canvas');
      const gl = canvas.getContext('webgl');
      if (!gl) return false;
      const info = gl.getExtension('WEBGL_debug_renderer_info');
      if (!info) return false;
      const renderer = String(gl.getParameter(info.UNMASKED_RENDERER_WEBGL));
      return /Apple\s*(M\d|GPU)/i.test(renderer);
    } catch {
      return false;
    }
  }

  function renderPrimary(match: Download): void {
    const container = document.getElementById('primary-download');
    const link = document.getElementById('primary-download-link') as HTMLAnchorElement | null;
    const label = document.getElementById('primary-download-label');
    const detail = document.getElementById('primary-download-detail');
    if (!container || !link || !label || !detail) return;

    link.href = match.url;
    label.textContent = `Uncached for ${match.label}`;
    detail.textContent = `${match.detail} · ${match.filename}`;
    container.classList.remove('hidden');
  }

  function renderList(downloads: Download[]): void {
    const list = document.getElementById('download-list');
    if (!list) return;

    list.removeAttribute('aria-busy');
    list.replaceChildren(
      ...downloads.map((download) => {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = download.url;
        link.className =
          'reveal flex items-center justify-between gap-4 rounded-xl border border-border-theme bg-surface px-5 py-4 transition-colors hover:border-accent';

        const text = document.createElement('span');
        text.className = 'flex flex-col';

        const name = document.createElement('span');
        name.className = 'text-sm font-semibold text-text-primary';
        name.textContent = `${download.label} — ${download.detail}`;

        const file = document.createElement('span');
        file.className = 'mt-0.5 font-mono text-[11px] text-text-muted';
        file.textContent = download.filename;

        text.append(name, file);

        const action = document.createElement('span');
        action.className = 'shrink-0 font-mono text-[11px] text-accent';
        action.textContent = 'Download';

        link.append(text, action);
        item.append(link);
        return item;
      }),
    );
  }

  function showStatus(message: string): void {
    const status = document.getElementById('download-status');
    if (!status) return;
    status.textContent = message;
    status.classList.toggle('sr-only', message === '');
  }

  /** Every placeholder goes at once, whichever way the lookup ended. */
  function clearSkeletons(): void {
    document.getElementById('primary-skeleton')?.remove();
    document.getElementById('release-notes-skeleton')?.remove();
    const list = document.getElementById('download-list');
    if (list?.hasAttribute('aria-busy')) {
      list.removeAttribute('aria-busy');
      list.replaceChildren();
    }
  }

  function showVersion(text: string): void {
    const version = document.getElementById('latest-version');
    if (!version) return;
    version.className = 'reveal';
    version.removeAttribute('aria-label');
    version.textContent = text;
  }

  async function loadManifest(): Promise<void> {
    let manifest: Manifest;
    try {
      const response = await fetch('/api/latest');
      if (!response.ok) throw new Error(String(response.status));
      manifest = await response.json();
    } catch {
      clearSkeletons();
      showVersion('unavailable');
      showStatus('Could not reach the release manifest. Refresh, or try again shortly.');
      return;
    }

    showVersion(manifest.version);

    const notes = document.getElementById('release-notes');
    if (notes) {
      notes.textContent = manifest.notes || 'No release notes were published.';
      notes.classList.remove('hidden');
    }

    if (manifest.downloads.length === 0) {
      clearSkeletons();
      showStatus('No builds are published for download yet.');
      return;
    }

    renderList(manifest.downloads);
    clearSkeletons();

    const key = detectPlatformKey();
    const match = manifest.downloads.find((download) => download.key === key);
    if (match) {
      renderPrimary(match);
      showStatus('');
    } else if (key === 'windows-x86_64') {
      showStatus('Uncached ships for macOS and Linux for now. Windows comes later, through the Microsoft Store — join the list below.');
    } else {
      showStatus('Pick the build for your machine.');
    }
  }

  // Absent when the gate is closed: the page renders no download UI at all.
  if (document.getElementById('download-status')) loadManifest();
</script>
