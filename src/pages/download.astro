---
import Layout from '../layouts/Layout.astro';
import { downloadsEnabled } from '../data/flags';

const title = downloadsEnabled
  ? 'Download Uncached — free for macOS, Windows, and Linux'
  : 'Download Uncached — opening soon';
const description = downloadsEnabled
  ? 'Download the latest Uncached build for macOS, Windows, or Linux. The free tier scans your workspaces and moves regenerable build artifacts to Trash.'
  : 'Uncached downloads open once the builds are signed. The free tier scans locally and moves regenerable build artifacts to Trash.';
const keywords =
  'download uncached, disk cleanup app download, node_modules cleaner download, macos build cache cleaner, windows developer disk cleaner';
---

<Layout title={title} description={description} keywords={keywords} noindex={!downloadsEnabled}>
  <main class="flex-1">
    <section class="mx-auto max-w-3xl px-6 pb-8 pt-16 text-center sm:pt-24">
      <h1
        class="mx-auto max-w-3xl text-pretty text-[2rem] font-semibold leading-[1.1] tracking-tighter text-text-primary sm:text-balance sm:text-5xl sm:leading-[1.05]"
      >
        {downloadsEnabled ? 'Get your disk back.' : 'Almost ready.'}
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-pretty text-base leading-7 text-text-secondary sm:text-lg">
        {
          downloadsEnabled
            ? 'Free, no account, no upload. Uncached scans locally and moves what you select to Trash or Recycle Bin.'
            : 'The builds are finished and the update path works. Downloads open once they are signed with an Apple Developer certificate, so the first launch does not accuse the app of being damaged.'
        }
      </p>
      {
        downloadsEnabled && (
          <p class="mt-4 font-mono text-xs text-text-muted">
            Version <span id="latest-version">checking…</span>
          </p>
        )
      }
    </section>

    {
      downloadsEnabled ? (
        <>
          <section class="mx-auto w-full max-w-3xl px-6 pb-6">
            <div id="primary-download" class="hidden">
              <a
                id="primary-download-link"
                href="#"
                class="flex flex-col items-center rounded-2xl border border-accent bg-surface p-7 text-center transition-colors hover:bg-raised"
              >
                <span class="text-lg font-semibold text-text-primary" id="primary-download-label" />
                <span class="mt-1 font-mono text-[11px] text-text-muted" id="primary-download-detail" />
                <span class="mt-5 inline-flex rounded-xl bg-accent px-6 py-3 text-sm font-semibold text-accent-text">
                  Download for free
                </span>
              </a>
            </div>

            <p
              id="download-status"
              role="status"
              aria-live="polite"
              class="text-center text-sm text-text-muted"
            >
              Looking up the latest release…
            </p>
          </section>

          <section class="mx-auto w-full max-w-3xl px-6 pb-14">
            <h2 class="mb-4 font-mono text-[11px] uppercase tracking-wider text-text-muted">
              All platforms
            </h2>
            <ul id="download-list" class="flex flex-col gap-3" />
          </section>

          <section class="mx-auto w-full max-w-3xl px-6 pb-16">
            <div class="rounded-2xl border border-border-theme bg-surface p-6">
              <h2 class="text-sm font-semibold text-text-primary">On first launch</h2>
              <p class="mt-3 text-xs leading-relaxed text-text-muted">
                Updates from inside the app are signed separately and are refused unless they match
                the key compiled into your copy.
              </p>
            </div>

            <div class="mt-3 rounded-2xl border border-border-theme bg-surface p-6">
              <h2 class="text-sm font-semibold text-text-primary">What is in this release</h2>
              <p id="release-notes" class="mt-3 whitespace-pre-line text-xs leading-relaxed text-text-muted" />
            </div>
          </section>
        </>
      ) : (
        <section class="mx-auto w-full max-w-2xl px-6 pb-20">
          <div class="rounded-2xl border border-border-theme bg-surface p-7 text-center">
            <p class="text-sm leading-6 text-text-secondary">
              Nothing is being held back for a paywall — the free tier is what opens first, and it
              opens for every platform at once.
            </p>
            <a
              href="/pricing"
              class="mt-6 inline-flex justify-center rounded-xl border border-border-theme bg-raised px-5 py-3 text-sm font-semibold text-text-primary transition-colors hover:border-accent hover:text-accent"
            >
              See what Pro adds
            </a>
          </div>
        </section>
      )
    }
  </main>
</Layout>

<script>
  interface Download {
    key: string;
    os: string;
    label: string;
    detail: string;
    url: string;
    filename: string;
  }

  interface Manifest {
    version: string;
    notes: string;
    pubDate: string | null;
    downloads: Download[];
  }

  /**
   * `navigator.userAgentData.platform` is not in every browser, so the classic
   * string is the fallback. Apple ships an identical UA for both Mac
   * architectures, so Silicon is inferred from the WebGL renderer instead.
   */
  function detectPlatformKey(): string | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return 'windows-x86_64';
    if (/Linux/i.test(ua) && !/Android/i.test(ua)) return 'linux-x86_64';
    if (!/Mac/i.test(ua)) return null;
    return isAppleSilicon() ? 'darwin-aarch64' : 'darwin-x86_64';
  }

  function isAppleSilicon(): boolean {
    try {
      const canvas = document.createElement('canvas');
      const gl = canvas.getContext('webgl');
      if (!gl) return false;
      const info = gl.getExtension('WEBGL_debug_renderer_info');
      if (!info) return false;
      const renderer = String(gl.getParameter(info.UNMASKED_RENDERER_WEBGL));
      return /Apple\s*(M\d|GPU)/i.test(renderer);
    } catch {
      return false;
    }
  }

  function renderPrimary(match: Download): void {
    const container = document.getElementById('primary-download');
    const link = document.getElementById('primary-download-link') as HTMLAnchorElement | null;
    const label = document.getElementById('primary-download-label');
    const detail = document.getElementById('primary-download-detail');
    if (!container || !link || !label || !detail) return;

    link.href = match.url;
    label.textContent = `Uncached for ${match.label}`;
    detail.textContent = `${match.detail} · ${match.filename}`;
    container.classList.remove('hidden');
  }

  function renderList(downloads: Download[]): void {
    const list = document.getElementById('download-list');
    if (!list) return;

    list.replaceChildren(
      ...downloads.map((download) => {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = download.url;
        link.className =
          'flex items-center justify-between gap-4 rounded-xl border border-border-theme bg-surface px-5 py-4 transition-colors hover:border-accent';

        const text = document.createElement('span');
        text.className = 'flex flex-col';

        const name = document.createElement('span');
        name.className = 'text-sm font-semibold text-text-primary';
        name.textContent = `${download.label} — ${download.detail}`;

        const file = document.createElement('span');
        file.className = 'mt-0.5 font-mono text-[11px] text-text-muted';
        file.textContent = download.filename;

        text.append(name, file);

        const action = document.createElement('span');
        action.className = 'shrink-0 font-mono text-[11px] text-accent';
        action.textContent = 'Download';

        link.append(text, action);
        item.append(link);
        return item;
      }),
    );
  }

  function showStatus(message: string): void {
    const status = document.getElementById('download-status');
    if (status) status.textContent = message;
  }

  async function loadManifest(): Promise<void> {
    let manifest: Manifest;
    try {
      const response = await fetch('/api/latest');
      if (!response.ok) throw new Error(String(response.status));
      manifest = await response.json();
    } catch {
      showStatus('Could not reach the release manifest. Refresh, or try again shortly.');
      return;
    }

    const version = document.getElementById('latest-version');
    if (version) version.textContent = manifest.version;

    const notes = document.getElementById('release-notes');
    if (notes) notes.textContent = manifest.notes || 'No release notes were published.';

    if (manifest.downloads.length === 0) {
      showStatus('No builds are published for download yet.');
      return;
    }

    renderList(manifest.downloads);

    const key = detectPlatformKey();
    const match = manifest.downloads.find((download) => download.key === key);
    if (match) {
      renderPrimary(match);
      showStatus('');
    } else {
      showStatus('Pick the build for your machine.');
    }
  }

  // Absent when the gate is closed: the page renders no download UI at all.
  if (document.getElementById('download-status')) loadManifest();
</script>
