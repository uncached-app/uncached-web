---
import Header from '../components/Header.astro';
import WhitelistForm from '../components/WhitelistForm';
import ScanSimulator from '../components/ScanSimulator';
import FeaturesSection from '../components/FeaturesSection.astro';
import PricingSection from '../components/PricingSection.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const siteTitle = "Uncached — Build Cache Cleaner for macOS, Windows & Linux";
const siteDescription = "Uncached scans your local repositories for disposable build targets, package caches, and toolchain artifacts to reclaim gigabytes of SSD space.";
const canonicalURL = "https://uncached.app/";
const siteKeywords = "build cache cleaner, node_modules cleaner, rust target cleaner, developer disk cleanup, reclaim SSD space, macOS cache cleaner, windows build cleaner, tauri developer tool, disk bloat cleaner";
const authorName = "Natan Viana";
const authorUrl = "https://natanviana.dev";

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Uncached",
  "operatingSystem": "macOS, Windows, Linux",
  "applicationCategory": "DeveloperApplication",
  "url": canonicalURL,
  "description": siteDescription,
  "offers": [
    {
      "@type": "Offer",
      "name": "Free Tier",
      "price": "0",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Pro Monthly",
      "price": "4.99",
      "priceCurrency": "USD"
    },
    {
      "@type": "Offer",
      "name": "Pro Lifetime",
      "price": "59.90",
      "priceCurrency": "USD"
    }
  ],
  "author": {
    "@type": "Person",
    "name": authorName,
    "url": authorUrl
  }
});
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{siteTitle}</title>
    <meta name="title" content={siteTitle} />
    <meta name="description" content={siteDescription} />
    <meta name="keywords" content={siteKeywords} />
    <meta name="author" content={authorName} />
    <meta name="publisher" content={authorName} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:image" content="https://uncached.app/brand/UNCACHED-LOGO-LIGHT-NOBG.svg" />
    <meta property="og:site_name" content="Uncached" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content="https://uncached.app/brand/UNCACHED-LOGO-LIGHT-NOBG.svg" />
    <meta name="twitter:creator" content="@natanviana" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={schemaJson} />

    <!-- Google Fonts: Hanken Grotesk & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- FOUT Prevention Theme Initializer -->
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('uncached-theme');
        if (savedTheme === 'light' || savedTheme === 'dark') {
          document.documentElement.dataset.theme = savedTheme;
        } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
          document.documentElement.dataset.theme = 'light';
        } else {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-canvas text-text-primary selection:bg-accent selection:text-accent-text transition-colors">
    <Header />

    <main class="flex-1">
      {/* Hero Section */}
      <section class="max-w-4xl mx-auto px-6 pt-16 pb-12 text-center">
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-text-primary mb-6 leading-[1.1] max-w-3xl mx-auto">
          Obliterate build bloat.<br class="hidden sm:block" /> Reclaim your SSD space.
        </h1>
        
        <p class="text-base sm:text-lg text-text-secondary max-w-2xl mx-auto mb-10 leading-relaxed">
          Uncached scans your local repositories for disposable build targets, package caches, and toolchain artifacts — giving you 1-click control to safely recycle or permanently clear gigabytes of wasted storage.
        </p>

        {/* Brevo Whitelist Component */}
        <WhitelistForm client:load />
      </section>

      {/* Simulator Section */}
      <section class="px-6 py-8">
        <ScanSimulator client:load />
      </section>

      {/* App Features Section */}
      <FeaturesSection />

      {/* Pricing Cards Section ($0, $4.99/mo, $59.90 lifetime) */}
      <PricingSection />

      {/* Support & FAQ Section */}
      <FaqSection />
    </main>

    <Footer />
  </body>
</html>
