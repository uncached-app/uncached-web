---
import Header from '../components/Header.astro';
import WhitelistForm from '../components/WhitelistForm';
import ScanSimulator from '../components/ScanSimulator';
import FeaturesSection from '../components/FeaturesSection.astro';
import FaqSection from '../components/FaqSection.astro';
import ProTeaser from '../components/ProTeaser.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const siteTitle = "Uncached — Reclaim gigabytes from the code you ship";
const siteDescription = "Uncached finds regenerable build artifacts in developer workspaces and safely moves selected targets to your system Trash or Recycle Bin.";
const canonicalURL = "https://uncached.app/";
const siteKeywords = "build cache cleaner, node_modules cleaner, rust target cleaner, developer disk cleanup, reclaim SSD space, macOS cache cleaner, windows build cleaner, tauri developer tool, disk bloat cleaner";
const authorName = "Natan Viana";
const authorUrl = "https://natanviana.dev";

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Uncached",
  "operatingSystem": "macOS, Windows, Linux",
  "applicationCategory": "DeveloperApplication",
  "url": canonicalURL,
  "description": siteDescription,
  "offers": [
    {
      "@type": "Offer",
      "name": "Early access",
      "price": "0",
      "priceCurrency": "USD",
      "availability": "https://schema.org/PreOrder"
    }
  ],
  "author": {
    "@type": "Person",
    "name": authorName,
    "url": authorUrl
  }
});
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{siteTitle}</title>
    <meta name="title" content={siteTitle} />
    <meta name="description" content={siteDescription} />
    <meta name="keywords" content={siteKeywords} />
    <meta name="author" content={authorName} />
    <meta name="publisher" content={authorName} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:image" content="https://uncached.app/brand/UNCACHED-LOGO-LIGHT-NOBG.svg" />
    <meta property="og:site_name" content="Uncached" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content="https://uncached.app/brand/UNCACHED-LOGO-LIGHT-NOBG.svg" />
    <meta name="twitter:creator" content="@natanviana" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={schemaJson} />

    <!-- Google Fonts: Hanken Grotesk & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- FOUT Prevention Theme Initializer -->
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('uncached-theme');
        if (savedTheme === 'light' || savedTheme === 'dark') {
          document.documentElement.dataset.theme = savedTheme;
        } else {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-canvas text-text-primary selection:bg-accent selection:text-accent-text transition-colors">
    <Header />

    <main class="flex-1">
      <section class="mx-auto max-w-4xl px-6 pb-12 pt-14 text-center sm:pt-20">
        <h1 class="mx-auto max-w-4xl text-4xl font-semibold leading-[1.05] tracking-tighter text-text-primary sm:text-5xl md:text-6xl">
          Reclaim disk from build artifacts.
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-text-secondary sm:text-lg">
          Uncached finds regenerable targets in your developer workspaces, shows exactly what can leave, and moves selected targets to Trash or Recycle Bin.
        </p>
        <div class="mx-auto mt-8 max-w-xl">
          <WhitelistForm client:load />
        </div>
        <div class="mt-5 flex justify-center gap-5 font-mono text-[11px] text-text-muted">
          <span>Local-first</span>
          <span>Trash by default</span>
        </div>
      </section>

      <section id="how-it-works" class="mx-auto max-w-6xl scroll-mt-12 px-6 py-8">
        <ScanSimulator client:load />
      </section>

      {/* App Features Section */}
      <FeaturesSection />

      <ProTeaser />

      {/* Support & FAQ Section */}
      <FaqSection />
    </main>

    <Footer />
  </body>
</html>
