---
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/FaqSection.astro';
import Screenshot from '../components/Screenshot.astro';
import GuidedDemo from '../demo/GuidedDemo';
import DemoSkeleton from '../demo/DemoSkeleton.astro';
import { faqs } from '../data/faqs';

const siteTitle = "Uncached — Reclaim gigabytes from the code you ship";
const siteDescription = "Uncached finds the dependency, build and cache folders your toolchains can rebuild, tells you which projects hold work that exists nowhere else, and moves what you pick to the Trash.";
const canonicalURL = "https://uncached.app/";
const siteKeywords = "build cache cleaner, node_modules cleaner, rust target cleaner, developer disk cleanup, reclaim SSD space, macOS cache cleaner, linux build cleaner, tauri developer tool, disk bloat cleaner";
const authorName = "Natan Viana";
const authorUrl = "https://natanviana.dev";

// Must be a raster format — no social platform renders SVG in link previews.
// Regenerate with `npm run og` after changing the tagline or brand colors.
const ogImage = "https://uncached.app/og-image.png";

// One @graph so the entities cross-reference by @id instead of repeating data.
const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://uncached.app/#website",
      "url": canonicalURL,
      "name": "Uncached",
      "description": siteDescription,
      "inLanguage": "en-US",
      "publisher": { "@id": "https://uncached.app/#author" }
    },
    {
      "@type": "Person",
      "@id": "https://uncached.app/#author",
      "name": authorName,
      "url": authorUrl
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://uncached.app/#app",
      "name": "Uncached",
      "operatingSystem": "macOS, Linux",
      "applicationCategory": "DeveloperApplication",
      "url": canonicalURL,
      "image": ogImage,
      "description": siteDescription,
      "featureList": [
        "Scans developer workspaces for regenerable build artifacts",
        "Reports measured sizes per target before any removal",
        "Moves selected targets to the system Trash",
        "Runs locally without uploading project contents",
        "Reports declared dependencies nothing in a project uses",
        "Flags env files, keys and credentials Git would publish"
      ],
      "offers": [
        {
          "@type": "Offer",
          "name": "Free",
          "price": "0",
          "priceCurrency": "USD",
          "availability": "https://schema.org/InStock",
          "url": "https://uncached.app/download"
        },
        {
          "@type": "Offer",
          "name": "Pro Annual",
          "price": "4.99",
          "priceCurrency": "USD",
          "availability": "https://schema.org/InStock",
          "url": "https://uncached.app/pricing"
        },
        {
          "@type": "Offer",
          "name": "Pro Lifetime",
          "price": "14.99",
          "priceCurrency": "USD",
          "availability": "https://schema.org/InStock",
          "url": "https://uncached.app/pricing"
        }
      ],
      "author": { "@id": "https://uncached.app/#author" }
    },
    {
      "@type": "FAQPage",
      "@id": "https://uncached.app/#faq",
      "mainEntity": faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
});

const features = [
  {
    title: 'Unpushed work is never touched',
    body: 'Uncommitted files, unpushed commits and stashes mark a project Protect. Its page says why, and which command rebuilds everything else.',
    image: '/screens/02-verdict.webp',
    height: 520,
    alt: 'The ledger-api project in Uncached, marked Protect because one file was never committed, with cargo build as the command that restores it.',
  },
  {
    title: 'You pick what goes',
    body: 'Every folder shows its size and why it can be rebuilt. It is checked again right before it moves to the Trash.',
    image: '/screens/03-review.webp',
    height: 560,
    alt: 'The Reclaim review in Uncached: twelve targets totalling 9.80 GB, each with its path and size, and a Move to Trash button.',
  },
  {
    title: 'Unused dependencies, too',
    body: 'Packages in package.json or Cargo.toml that nothing in the project imports, with the command that removes them.',
    image: '/screens/04-unused.webp',
    height: 470,
    alt: 'The Dependencies screen in Uncached listing expo-status-bar as unused, with npm uninstall expo-status-bar as the command that removes it.',
  },
];

const folders = [
  'node_modules', 'target', '.next', '.nuxt', '.svelte-kit', '.angular', '.turbo', '.expo',
  'Pods', 'DerivedData', '.build', '.gradle', 'build', '__pycache__', '.mypy_cache',
  '.pytest_cache', '.ruff_cache', '.tox', '.pixi', 'bin', 'obj', '.dart_tool', '_build',
  '.stack-work', 'dist-newstyle', '.zig-cache', 'zig-out', 'cmake-build-debug', 'vendor',
  '.terraform', 'Library', 'Intermediate', '.godot',
];

const safety = [
  ['Trash, not rm', 'Everything moves to the system Trash, where you can put it back.'],
  ['Checked twice', 'When a folder is found, and again right before it moves.'],
  ['Nothing uploaded', 'Scans run on your machine, without an account.'],
  ['Signed', 'Notarised by Apple on macOS, with signed updates.'],
];
---

<Layout title={siteTitle} description={siteDescription} keywords={siteKeywords}>
  <script type="application/ld+json" slot="head" set:html={schemaJson} />

  <main class="flex-1">
    <section class="container pt-16 pb-16 text-center sm:pt-24">
      <h1 class="mx-auto max-w-3xl text-balance text-[2.5rem] font-bold leading-[1.02] tracking-[-0.045em] text-text-primary sm:text-6xl">
        Delete build folders without losing work.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-pretty text-base leading-7 text-text-secondary sm:text-lg">
        Uncached finds node_modules, target, Pods and the other folders your tools can rebuild. Projects with unpushed work stay protected, and the rest goes to the Trash.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href="/download"
          class="inline-flex h-12 items-center justify-center rounded-xl bg-accent px-6 text-sm font-semibold text-accent-text transition-colors hover:bg-accent-hover"
        >
          Download free
        </a>
        <a
          href="/pricing"
          class="inline-flex h-12 items-center justify-center rounded-xl border border-border-theme bg-surface px-6 text-sm font-semibold text-text-primary transition-colors hover:border-accent-ink hover:text-accent-ink"
        >
          See pricing
        </a>
      </div>
    </section>

    <div id="how-it-works" class="scroll-mt-4"></div>
    <div class="hidden lg:block">
      <GuidedDemo client:only="react">
        <DemoSkeleton slot="fallback" />
      </GuidedDemo>
    </div>

    <div class="container lg:hidden">
      <Screenshot
        src="/screens/01-workspace.webp"
        width={1080}
        height={800}
        alt="The Uncached workspace: seven projects, 9.80 GB reclaimable, grouped by verdict, with ledger-api and design-system marked Protect because they hold uncommitted work and a stash."
        priority
      />
    </div>

    <div class="lg:hidden">
      {features.map((feature) => (
        <section class="container pt-28">
          <h2 class="mx-auto max-w-2xl text-balance text-center text-3xl font-bold tracking-[-0.04em] text-text-primary sm:text-4xl">
            {feature.title}
          </h2>
          <p class="mx-auto mt-4 max-w-xl text-pretty text-center text-base leading-7 text-text-secondary">
            {feature.body}
          </p>
          <div class="mt-10">
            <Screenshot src={feature.image} width={1080} height={feature.height} alt={feature.alt} cropped />
          </div>
        </section>
      ))}
    </div>

    <section class="container pt-20 pb-24">
      <h2 class="text-balance text-center text-3xl font-bold tracking-[-0.04em] text-text-primary sm:text-4xl">
        What it cleans
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-pretty text-center text-base leading-7 text-text-secondary">
        Each folder is confirmed by the project file beside it, never by its name alone.
      </p>
      <ul class="mx-auto mt-10 flex max-w-4xl flex-wrap justify-center gap-2">
        {folders.map((folder) => (
          <li class="rounded-lg border border-border-theme bg-surface px-3 py-1.5 font-mono text-sm text-text-primary">{folder}</li>
        ))}
      </ul>
    </section>

    <section class="border-y border-border-theme bg-surface">
      <dl class="container grid gap-x-8 gap-y-8 py-16 sm:grid-cols-2 lg:grid-cols-4">
        {safety.map(([term, detail]) => (
          <div>
            <dt class="text-base font-semibold text-text-primary">{term}</dt>
            <dd class="mt-2 text-sm leading-6 text-text-secondary">{detail}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="container py-24">
      <div class="flex flex-col gap-8 rounded-3xl border border-pro-border bg-pro-surface p-8 sm:p-10 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-xl">
          <h2 class="text-3xl font-bold tracking-[-0.04em] text-text-primary">Uncached Pro</h2>
          <p class="mt-3 text-base leading-7 text-text-secondary">
            Scheduled cleanups, machine-wide caches, up to 12 workspace folders, every duplicate dependency and the full history.
          </p>
        </div>
        <div class="flex flex-col gap-3 lg:items-end">
          <p class="font-mono text-lg text-text-primary">$4.99 a year · $14.99 once</p>
          <a
            href="/pricing"
            class="inline-flex h-12 items-center justify-center rounded-xl bg-pro px-6 text-sm font-semibold text-pro-text transition-colors hover:bg-pro-hover"
          >
            See Pro
          </a>
        </div>
      </div>
    </section>

    <FaqSection />

    <section class="border-t border-border-theme">
      <div class="container flex flex-col items-center gap-6 py-24 text-center">
        <h2 class="text-3xl font-bold tracking-[-0.04em] text-text-primary sm:text-4xl">Download Uncached</h2>
        <a
          href="/download"
          class="inline-flex h-12 items-center justify-center rounded-xl bg-accent px-6 text-sm font-semibold text-accent-text transition-colors hover:bg-accent-hover"
        >
          Download free
        </a>
      </div>
    </section>
  </main>
</Layout>
