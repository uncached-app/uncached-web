---
import Layout from '../layouts/Layout.astro';
import { freeFeatures, proFeatures, proPrices } from '../data/plans';
import { checkoutEnabled } from '../data/flags';

const title = 'Pricing — Uncached';
const description =
  'Uncached Free reclaims every artifact of every project, with no limits. Pro adds the automation, the duplicate insights and the history for $4.99 a year or $14.99 once.';
const keywords =
  'uncached pricing, disk cleanup tool price, build cache cleaner license, developer disk cleaner lifetime license';

const canonicalURL = 'https://uncached.app/pricing';

const comparison: [string, string, string][] = [
  ['Every dependency, build and cache folder in your projects', 'Yes', 'Yes'],
  ['Verdicts, confidence, and the check again at removal', 'Yes', 'Yes'],
  ['Unused dependencies and the disk overview', 'Yes', 'Yes'],
  ['Workspace folders at once', '1', '12'],
  ['Machine-wide caches: package managers, AI tools, editors', '—', 'Yes'],
  ['Scheduled maintenance', 'Preview', 'Runs'],
  ['Duplicate dependencies across projects', 'Top 3', 'All'],
  ['Reclaim history and insights', '—', 'Yes'],
  ['App icons for the Dock', '—', '6'],
];

const schemaJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Uncached Pro',
  description,
  url: canonicalURL,
  brand: { '@type': 'Brand', name: 'Uncached' },
  offers: proPrices.map((price) => ({
    '@type': 'Offer',
    name: price.id === 'annual' ? 'Pro Annual' : 'Pro Lifetime',
    price: price.price.replace('$', ''),
    priceCurrency: 'USD',
    availability: checkoutEnabled ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
    url: canonicalURL,
  })),
});
---

<Layout title={title} description={description} keywords={keywords}>
  <script type="application/ld+json" slot="head" set:html={schemaJson} />

  <main class="flex-1">
    <section class="container pb-14 pt-12 sm:pt-20">
      <h1 class="max-w-3xl text-balance text-[2.5rem] font-bold leading-[1.04] tracking-[-0.045em] text-text-primary sm:text-6xl">
        Free already reclaims everything.
      </h1>
      <p class="mt-6 max-w-2xl text-pretty text-base leading-7 text-text-secondary sm:text-lg">
        No locked scanners, no smaller safety checks, no project it refuses to look at. Pro adds what runs and remembers on its own, and never takes anything away from Free.
      </p>
    </section>

    <section class="container grid gap-5 lg:grid-cols-12">
      <div class="flex flex-col rounded-3xl border border-border-theme bg-surface p-8 sm:p-10 lg:col-span-5">
        <h2 class="text-lg font-semibold text-text-primary">Free</h2>
        <p class="mt-1 text-sm text-text-muted">For every project, forever.</p>
        <p class="mt-6 flex items-baseline gap-2">
          <span class="font-mono text-5xl font-bold tracking-tight text-text-primary">$0</span>
        </p>
        <ul class="mt-7 flex flex-1 flex-col gap-3">
          {freeFeatures.map((feature) => (
            <li class="flex items-start gap-3 text-sm leading-6 text-text-secondary">
              <span aria-hidden="true" class="mt-2 size-2 shrink-0 rounded-[2px] bg-accent" />
              <span>{feature}</span>
            </li>
          ))}
        </ul>
        <a
          href="/download"
          class="mt-8 inline-flex h-12 items-center justify-center rounded-xl border border-border-theme bg-raised px-5 text-sm font-semibold text-text-primary transition-colors hover:border-accent-ink hover:text-accent-ink"
        >
          Download free
        </a>
      </div>

      <div class="flex flex-col rounded-3xl border border-pro-border bg-pro-surface p-8 sm:p-10 lg:col-span-7">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 class="text-lg font-semibold text-text-primary">Pro</h2>
          <span class="text-sm text-pro-muted">One machine per licence, activated offline.</span>
        </div>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {proFeatures.map((feature) => (
            <li class="flex items-start gap-3 text-sm leading-6 text-text-secondary">
              <span aria-hidden="true" class="mt-2 size-2 shrink-0 rounded-full bg-pro" />
              <span>{feature}</span>
            </li>
          ))}
        </ul>

        <div class="mt-8 grid flex-1 gap-4 sm:grid-cols-2">
          {proPrices.map((option) => (
            <div
              class:list={[
                'relative flex flex-col rounded-2xl border bg-surface p-5',
                option.featured ? 'border-pro' : 'border-pro-border',
              ]}
            >
              {option.featured && (
                <span class="absolute -top-2.5 right-4 rounded-full bg-pro px-2.5 py-0.5 text-[11px] font-semibold text-pro-text">
                  Three years of annual
                </span>
              )}
              <p class="flex items-baseline gap-1.5">
                <span class="font-mono text-4xl font-bold tracking-tight text-text-primary">{option.price}</span>
                <span class="text-sm text-text-muted">{option.cadence}</span>
              </p>
              <p class="mt-2 flex-1 text-sm leading-6 text-text-muted">{option.note}</p>
              {checkoutEnabled && option.priceId ? (
                <button
                  type="button"
                  data-paddle-price={option.priceId}
                  class:list={[
                    'mt-5 inline-flex h-12 cursor-pointer items-center justify-center rounded-xl px-5 text-sm font-semibold transition-colors',
                    option.featured
                      ? 'bg-pro text-pro-text hover:bg-pro-hover'
                      : 'border border-pro-border bg-pro-surface text-text-primary hover:border-pro',
                  ]}
                >
                  {option.cta}
                </button>
              ) : (
                <button
                  type="button"
                  disabled
                  class="mt-5 inline-flex h-12 cursor-not-allowed items-center justify-center rounded-xl border border-pro-border px-5 text-sm font-semibold text-pro-muted opacity-60"
                >
                  Coming soon
                </button>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <p
      id="checkout-error"
      role="status"
      aria-live="polite"
      class="container mt-4 hidden text-center text-sm text-destructive"
    >
    </p>

    <section class="container pt-20">
      <h2 class="text-2xl font-bold tracking-[-0.04em] text-text-primary sm:text-3xl">Free and Pro, side by side</h2>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[560px] border-collapse text-sm">
          <thead>
            <tr class="border-b border-border-theme text-left">
              <th scope="col" class="py-3 pr-4 font-medium text-text-muted"></th>
              <th scope="col" class="w-32 py-3 pr-4 font-semibold text-text-primary">Free</th>
              <th scope="col" class="w-32 py-3 font-semibold text-text-primary">Pro</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map(([row, free, pro]) => (
              <tr class="border-b border-border-theme">
                <th scope="row" class="py-3.5 pr-4 text-left font-normal text-text-secondary">{row}</th>
                <td class:list={['py-3.5 pr-4 font-mono', free === '—' ? 'text-text-muted' : 'text-text-primary']}>{free}</td>
                <td class="py-3.5 font-mono text-text-primary">{pro}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="container py-20">
      <dl class="grid gap-x-12 gap-y-8 border-t border-border-theme pt-10 md:grid-cols-3">
        <div>
          <dt class="text-sm font-semibold text-text-primary">One machine</dt>
          <dd class="mt-2 text-sm leading-6 text-text-muted">
            The seat count travels inside the signed licence, so the condition lives in the purchase rather than only on this page. A second machine is a second licence.
          </dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-text-primary">Activated offline</dt>
          <dd class="mt-2 text-sm leading-6 text-text-muted">
            The key arrives by email. Paste it into Settings → Licence, where the app checks it against a key compiled into the binary. Nothing is sent anywhere to verify it.
          </dd>
        </div>
        <div>
          <dt class="text-sm font-semibold text-text-primary">Tax handled</dt>
          <dd class="mt-2 text-sm leading-6 text-text-muted">
            Paddle is the merchant of record. VAT and sales tax are worked out at checkout, and the invoice comes from Paddle in your local currency where it is supported.
          </dd>
        </div>
      </dl>
    </section>
  </main>
</Layout>

<script>
  import { initializePaddle, type Paddle } from '@paddle/paddle-js';

  const CLIENT_TOKEN = import.meta.env.PUBLIC_PADDLE_CLIENT_TOKEN ?? '';

  /** Paddle mints sandbox tokens with a `test_` prefix and live ones with `live_`. */
  function environmentForToken(token: string): 'sandbox' | 'production' {
    return token.startsWith('test_') ? 'sandbox' : 'production';
  }

  function currentTheme(): 'light' | 'dark' {
    return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  function showError(message: string): void {
    const banner = document.getElementById('checkout-error');
    if (!banner) return;
    banner.textContent = message;
    banner.classList.remove('hidden');
  }

  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-paddle-price]'));

  if (buttons.length > 0) {
    if (!CLIENT_TOKEN) {
      buttons.forEach((button) => {
        button.disabled = true;
      });
      showError('Checkout is not configured yet.');
    } else {
      let paddle: Paddle | undefined;

      initializePaddle({
        token: CLIENT_TOKEN,
        environment: environmentForToken(CLIENT_TOKEN),
        checkout: { settings: { displayMode: 'overlay', theme: currentTheme() } },
      })
        .then((instance) => {
          paddle = instance;
        })
        .catch(() => {
          buttons.forEach((button) => {
            button.disabled = true;
          });
          showError('Checkout could not load. Refresh the page or try again shortly.');
        });

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const priceId = button.dataset.paddlePrice;
          if (!paddle || !priceId) {
            showError('Checkout is still loading. Try again in a moment.');
            return;
          }

          // Read at click time: the system theme can change after load.
          paddle.Checkout.open({
            items: [{ priceId, quantity: 1 }],
            settings: {
              displayMode: 'overlay',
              theme: currentTheme(),
              successUrl: `${window.location.origin}/thank-you`,
            },
          });
        });
      });
    }
  }
</script>
