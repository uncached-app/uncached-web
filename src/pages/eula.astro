const title = 'End User License Agreement (EULA) — Uncached';
const description = 'End User License Agreement and Terms of Service for Uncached desktop application and developer tools.';
---

<Layout title={title} description={description}>
  <main class="py-16 sm:py-24">
    <article class="mx-auto max-w-3xl px-6">
      <!-- Page Header -->
      <header class="border-b border-border-theme pb-8">
