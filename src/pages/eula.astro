          </ol>
        </section>

        <!-- Section 3 -->
        <section class="border-t border-border-theme/40 pt-8">
          <h2 class="text-lg font-semibold text-text-primary">
            3. User-Authorized File Operations &amp; Liability
          </h2>
          <div class="mt-3 space-y-3">
            <p>
