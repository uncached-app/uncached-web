---
import Logo from './Logo.astro';
---

<footer class="w-full border-t border-border-theme py-10 bg-canvas transition-colors">
  <div class="container flex flex-col md:flex-row items-center justify-between gap-6">
    {/* Brand Logo & Copyright */}
    <div class="flex items-center gap-3">
      <Logo intro={false} class="h-5 w-auto text-text-primary opacity-90" />
      <span class="text-xs text-text-muted font-mono">© 2026</span>
    </div>

    {/* Dev-Focused Tagline */}
      <p class="text-xs text-text-muted font-mono text-center">
       Reclaim disk from build artifacts.
    </p>

    {/* Navigation Links & Theme Toggle */}
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-text-secondary font-mono">
      <a href="/#how-it-works" class="hover:text-accent-ink transition-colors">How it works</a>
      <a href="/pricing" class="hover:text-accent-ink transition-colors">Pricing</a>
      <a href="/download" class="hover:text-accent-ink transition-colors">Download</a>
      <a href="/#faq" class="hover:text-accent-ink transition-colors">FAQ</a>
      <a href="/eula" class="hover:text-accent-ink transition-colors">EULA</a>
    </div>
  </div>
</footer>
