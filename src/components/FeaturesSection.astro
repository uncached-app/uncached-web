---
const features = [
  {
    title: "Multi-Ecosystem Scanners",
    desc: "Identifies heavy disposable build targets across major developer ecosystems, language toolchains, and package managers without manual folder hunting.",
    tag: "Target Detection"
  },
  {
    title: "System Trash & Permanent Nuke",
    desc: "Safely transfers build folders to your native OS Recycle Bin for instant restoration, or permanently nukes targets to immediately free disk space.",
    tag: "Flexible Execution"
  },
  {
    title: "Native Tauri 2 + Rust Engine",
    desc: "Compiled in Rust. Starts in milliseconds, uses under 30MB of RAM, and runs asynchronous multi-threaded directory walks without bottlenecking CPU.",
    tag: "Native Speed"
  },
  {
    title: "Automated Daemon Purge (Pro)",
    desc: "Configure background daemon schedules to automatically purge abandoned build targets older than 14 days without manual intervention.",
    tag: "Background Daemon"
  },
  {
    title: "Deep IDE & Docker Cleaners (Pro)",
    desc: "Deep cleans Xcode DerivedData, Android Studio system caches, JetBrains build caches, and dangling Docker images & volumes.",
    tag: "Deep Clean"
  },
  {
    title: "Disk Reclaim Analytics (Pro)",
    desc: "Track reclaimed SSD storage over time with interactive graphs, per-project breakdown stats, and workspace growth metrics.",
    tag: "Analytics"
  }
];
---

<section id="features" class="w-full max-w-6xl mx-auto px-6 py-20 scroll-mt-12">
  <div class="text-center max-w-3xl mx-auto mb-14">
    <span class="text-xs font-mono text-text-muted uppercase tracking-widest block mb-2">
      Local Dev Utility
    </span>
    <h2 class="text-3xl md:text-5xl font-semibold tracking-[-0.04em] text-text-primary max-w-3xl mx-auto leading-[1.15]">
      Built for developers shipping code,<br class="hidden sm:block" /> not storing build bloat.
    </h2>
    <p class="mt-3 text-sm text-text-muted leading-relaxed">
      Automated multi-threaded scanning, deep IDE cleaners, and zero-overhead Rust execution for your local environment.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {features.map((item) => (
      <div class="p-6 rounded-2xl bg-surface border border-border-theme flex flex-col justify-between transition-colors">
        <div>
          <div class="mb-3">
            <span class="inline-block px-2.5 py-0.5 rounded-md bg-raised text-accent text-[11px] font-mono border border-border-theme">
              {item.tag}
            </span>
          </div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">
            {item.title}
          </h3>
          <p class="text-xs text-text-muted leading-relaxed">
            {item.desc}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
