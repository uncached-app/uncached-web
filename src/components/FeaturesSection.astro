---
const features = [
  {
    title: "Targets you can verify",
    desc: "Review real paths, categories, and byte sizes before anything moves.",
    tag: "Review first"
  },
  {
    title: "Trash by default",
    desc: "Selected targets move to your native Trash or Recycle Bin so cleanup stays reversible by default.",
    tag: "Safety first"
  },
  {
    title: "Local-first by design",
    desc: "Scanning and cleanup happen on your machine. Your workspace paths do not need to leave the device.",
    tag: "No cloud upload"
  },
  {
    title: "Built for toolchains",
    desc: "Current early-access coverage includes Node, Rust, Python caches, Gradle, Next.js, and Turborepo targets.",
    tag: "Current coverage"
  },
];
---

<section id="features" class="w-full max-w-6xl mx-auto px-6 py-20 scroll-mt-12">
  <div class="text-center max-w-3xl mx-auto mb-14">
    <span class="text-xs font-mono text-text-muted uppercase tracking-widest block mb-2">
      Built for local workspaces
    </span>
    <h2 class="text-3xl md:text-5xl font-semibold tracking-[-0.04em] text-text-primary max-w-3xl mx-auto leading-[1.15]">
      Less hunting. More disk for the work.
    </h2>
    <p class="mt-3 text-sm text-text-muted leading-relaxed">
      Uncached turns regenerable build artifacts into a short, reviewable cleanup flow.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
    {features.map((item) => (
      <div class="p-6 rounded-2xl bg-surface border border-border-theme flex flex-col justify-between transition-colors">
        <div>
          <div class="mb-3">
            <span class="inline-block px-2.5 py-0.5 rounded-md bg-raised text-accent text-[11px] font-mono border border-border-theme">
              {item.tag}
            </span>
          </div>
          <h3 class="text-base font-semibold text-text-primary mb-1.5">
            {item.title}
          </h3>
          <p class="text-xs text-text-muted leading-relaxed">
            {item.desc}
          </p>
        </div>
      </div>
    ))}
  </div>
</section>
