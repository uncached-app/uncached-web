---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  /** Fades the bottom edge out, for captures cut short of the window's end. */
  cropped?: boolean;
  priority?: boolean;
}

const { src, alt, width, height, cropped = false, priority = false } = Astro.props;
---

<img
  src={src}
  width={width}
  height={height}
  alt={alt}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  class:list={[
    'h-auto w-full ring-1 ring-border-theme',
    cropped
      ? 'rounded-t-[10px] [mask-image:linear-gradient(to_bottom,#000_90%,transparent)]'
      : 'rounded-[10px] shadow-[0_24px_60px_-12px_rgb(0_0_0/0.35)]',
  ]}
/>
