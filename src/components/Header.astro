---
import Logo from './Logo.astro';
---

<header class="container relative py-6 min-h-[5rem] flex items-center justify-between">
  <a href="/" class="flex items-center gap-3 group h-8">
    <Logo class="h-5 w-auto text-text-primary transition-opacity group-hover:opacity-90" />
  </a>

  <!-- Desktop Navigation Links -->
  <nav aria-label="Main Navigation" class="hidden md:flex items-center gap-8 text-sm font-medium text-text-secondary">
    <a href="/#how-it-works" class="hover:text-accent-ink transition-colors">How it works</a>
    <a href="/pricing" class="hover:text-accent-ink transition-colors">Pricing</a>
    <a href="/#faq" class="hover:text-accent-ink transition-colors">FAQ</a>
  </nav>

  <!-- Right Actions Container -->
  <div class="flex items-center gap-3 sm:gap-4 h-8">
    <!-- Desktop-Only CTA Button -->
    <a
      href="/download"
      class="hidden md:inline-flex px-4 py-2 text-xs font-semibold text-accent-text bg-accent hover:bg-accent-hover rounded-xl transition-colors shadow-sm"
    >
      Get Uncached
    </a>

    <!-- Mobile Animated Hamburger Toggle Button -->
    <button
      id="mobile-menu-toggle"
      type="button"
      aria-label="Toggle Navigation Menu"
      aria-expanded="false"
      aria-controls="mobile-sidebar"
      class="md:hidden p-1 flex flex-col justify-center items-end gap-1.25 w-8 h-8 bg-transparent border-none outline-none cursor-pointer"
    >
      <span class="burger-line-top"></span>
      <span class="burger-line-mid"></span>
      <span class="burger-line-bot"></span>
    </button>
  </div>
</header>

<!-- Mobile sidebar backdrop. -->
<div
  id="mobile-sidebar-backdrop"
  class="fixed inset-0 bg-black/30 backdrop-blur-xs z-40 transition-opacity duration-300 opacity-0 pointer-events-none md:hidden"
></div>

<!-- Mobile side panel follows site theme tokens. -->
<aside
  id="mobile-sidebar"
  class="fixed top-0 right-0 bottom-0 w-[75vw] max-w-xs h-full bg-canvas z-50 flex flex-col justify-start p-8 pt-24 transition-transform duration-300 ease-in-out translate-x-full md:hidden border-l border-border-theme shadow-2xl text-text-primary"
>
  <nav aria-label="Mobile Navigation" class="flex flex-col gap-6 items-start">
    <a href="/#how-it-works" class="mobile-nav-link text-lg font-normal text-text-primary hover:text-accent-ink transition-colors">
      How it works
    </a>
    <a href="/pricing" class="mobile-nav-link text-lg font-normal text-text-primary hover:text-accent-ink transition-colors">
      Pricing
    </a>
    <a href="/#faq" class="mobile-nav-link text-lg font-normal text-text-primary hover:text-accent-ink transition-colors">
      FAQ
    </a>
    <a
      href="/download"
      class="mobile-nav-link mt-2 px-5 py-2.5 text-sm font-semibold text-accent-text bg-accent hover:bg-accent-hover rounded-xl transition-colors shadow-sm inline-block"
    >
      Get Uncached
    </a>
  </nav>
</aside>

<style>
  .burger-line-top,
  .burger-line-mid,
  .burger-line-bot {
    height: 2px;
    background-color: var(--text-primary);
    border-radius: 9999px;
    transition: transform 0.3s ease, opacity 0.3s ease, width 0.3s ease, background-color 0.3s ease;
  }

  .burger-line-top {
    width: 1.5rem;
    transform-origin: center;
  }

  .burger-line-mid {
    width: 1.5rem;
  }

  .burger-line-bot {
    width: 1rem;
    transform-origin: center;
  }

  /* When menu is open: switch button to fixed top-6 right-6 z-70 (root stacking context) & morph to X */
  :global(#mobile-menu-toggle.menu-open) {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 70;
  }

  :global(#mobile-menu-toggle.menu-open) .burger-line-top {
    transform: translateY(7px) rotate(45deg);
    background-color: var(--text-primary) !important;
  }

  :global(#mobile-menu-toggle.menu-open) .burger-line-mid {
    opacity: 0;
    transform: scaleX(0);
  }

  :global(#mobile-menu-toggle.menu-open) .burger-line-bot {
    width: 1.5rem !important;
    transform: translateY(-7px) rotate(-45deg);
    background-color: var(--text-primary) !important;
  }
</style>

<script>
  // Mobile Sidebar & Animated Hamburger Controller
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const sidebar = document.getElementById('mobile-sidebar');
  const backdrop = document.getElementById('mobile-sidebar-backdrop');
  const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

  let isMenuOpen = false;

  function setMenuState(open: boolean) {
    isMenuOpen = open;
    if (toggleBtn) {
      toggleBtn.setAttribute('aria-expanded', String(open));
      if (open) {
        toggleBtn.classList.add('menu-open');
      } else {
        toggleBtn.classList.remove('menu-open');
      }
    }

    // Toggle Sidebar Slide-in
    if (sidebar) {
      if (open) {
        sidebar.classList.remove('translate-x-full');
        sidebar.classList.add('translate-x-0');
      } else {
        sidebar.classList.remove('translate-x-0');
        sidebar.classList.add('translate-x-full');
      }
    }

    // Toggle Backdrop Fade-in
    if (backdrop) {
      if (open) {
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
      } else {
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
        backdrop.classList.add('opacity-0', 'pointer-events-none');
      }
    }
  }

  toggleBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    setMenuState(!isMenuOpen);
  });

  backdrop?.addEventListener('click', () => {
    setMenuState(false);
  });

  // Close when clicking nav links
  mobileNavLinks.forEach((link) => {
    link.addEventListener('click', () => {
      setMenuState(false);
    });
  });

  // Close on Escape key press
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen) {
      setMenuState(false);
    }
  });
</script>
