---
---

<header class="relative w-full max-w-6xl mx-auto px-6 py-6 flex items-center justify-between z-40">
  <a href="/" class="flex items-center gap-3 group">
    <!-- Uncached Logo swapping dynamically per theme -->
    <img 
      id="uncached-header-logo"
      src="/brand/UNCACHED-LOGO-DARK-NOBG.svg" 
      alt="Uncached Logo" 
      class="h-5 w-auto object-contain transition-opacity group-hover:opacity-90"
    />
  </a>

  <!-- Desktop Navigation Links -->
  <nav aria-label="Main Navigation" class="hidden md:flex items-center gap-8 text-sm font-medium text-text-secondary">
    <a href="#features" class="hover:text-accent transition-colors">Features</a>
    <a href="#pricing" class="hover:text-accent transition-colors">Pricing</a>
    <a href="#faq" class="hover:text-accent transition-colors">Support</a>
  </nav>

  <!-- Right Actions Container -->
  <div class="flex items-center gap-3 sm:gap-4">
    <!-- Desktop-Only CTA Button -->
    <a
      href="#pricing"
      class="hidden md:inline-flex px-4 py-2 text-xs font-semibold text-accent-text bg-accent hover:bg-accent-hover rounded-xl transition-colors shadow-sm"
    >
      Get Uncached
    </a>

    <!-- Mobile Hamburger Toggle Button (No background, 3 lines: 2 long, 1 short) -->
    <button
      id="mobile-menu-toggle"
      type="button"
      aria-label="Toggle Navigation Menu"
      aria-expanded="false"
      aria-controls="mobile-sidebar"
      class="md:hidden relative z-[60] p-1 flex flex-col justify-center items-end gap-[5px] w-8 h-8 bg-transparent border-none outline-none cursor-pointer group"
    >
      <span id="line-top" class="h-[2px] w-6 bg-text-primary rounded-full transition-all duration-300 ease-in-out origin-center"></span>
      <span id="line-mid" class="h-[2px] w-6 bg-text-primary rounded-full transition-all duration-300 ease-in-out"></span>
      <span id="line-bot" class="h-[2px] w-4 bg-text-primary rounded-full transition-all duration-300 ease-in-out origin-center"></span>
    </button>
  </div>
</header>

<!-- Mobile Sidebar Backdrop Overlay with backdrop-blur-xs -->
<div
  id="mobile-sidebar-backdrop"
  class="fixed inset-0 bg-black/30 backdrop-blur-xs z-40 transition-opacity duration-300 opacity-0 pointer-events-none md:hidden"
></div>

<!-- Mobile Side Panel (100% White Background, No Borders, No Shadows) -->
<aside
  id="mobile-sidebar"
  class="fixed top-0 right-0 bottom-0 w-[80vw] max-w-xs h-full bg-white z-50 flex flex-col justify-between p-8 transition-transform duration-300 ease-in-out translate-x-full md:hidden border-none shadow-none text-gray-900"
>
  <!-- Top Bar inside Sidebar with Close 'X' Button (No title, no divider line) -->
  <div class="flex items-center justify-end w-full pt-2 pb-4">
    <button
      id="mobile-sidebar-close"
      type="button"
      aria-label="Close Menu"
      class="p-2 -mr-2 text-gray-500 hover:text-gray-900 transition-colors focus:outline-none"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Navigation Links -->
  <nav aria-label="Mobile Navigation" class="flex flex-col gap-6 my-auto">
    <a href="#features" class="mobile-nav-link text-2xl font-semibold text-gray-900 hover:text-accent transition-colors">
      Features
    </a>
    <a href="#pricing" class="mobile-nav-link text-2xl font-semibold text-gray-900 hover:text-accent transition-colors">
      Pricing
    </a>
    <a href="#faq" class="mobile-nav-link text-2xl font-semibold text-gray-900 hover:text-accent transition-colors">
      Support
    </a>
  </nav>

  <!-- Bottom CTA: Get Uncached Button -->
  <div class="flex flex-col gap-4 pb-4">
    <a
      href="#pricing"
      class="mobile-nav-link w-full text-center py-3.5 text-sm font-semibold text-accent-text bg-accent hover:bg-accent-hover rounded-xl transition-colors shadow-sm block"
    >
      Get Uncached
    </a>
  </div>
</aside>

<script>
  function updateHeaderLogo(theme: string) {
    const logoImg = document.getElementById('uncached-header-logo') as HTMLImageElement | null;
    if (logoImg) {
      logoImg.src = theme === 'light' 
        ? '/brand/UNCACHED-LOGO-DARK-NOBG.svg' 
        : '/brand/UNCACHED-LOGO-LIGHT-NOBG.svg';
    }
  }

  // Initial Sync
  const initialTheme = document.documentElement.dataset.theme || 'light';
  updateHeaderLogo(initialTheme);

  // Listen to Theme Toggle events
  window.addEventListener('theme-change', (e: Event) => {
    const customEvent = e as CustomEvent<{ theme: string }>;
    updateHeaderLogo(customEvent.detail.theme);
  });

  // Mobile Sidebar & Animated Hamburger Controller
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-sidebar-close');
  const sidebar = document.getElementById('mobile-sidebar');
  const backdrop = document.getElementById('mobile-sidebar-backdrop');
  const lineTop = document.getElementById('line-top');
  const lineMid = document.getElementById('line-mid');
  const lineBot = document.getElementById('line-bot');
  const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

  let isMenuOpen = false;

  function setMenuState(open: boolean) {
    isMenuOpen = open;
    if (toggleBtn) {
      toggleBtn.setAttribute('aria-expanded', String(open));
    }
    
    // Animate Hamburger into X and back
    if (lineTop && lineMid && lineBot) {
      if (open) {
        lineTop.classList.add('translate-y-[7px]', 'rotate-45');
        lineMid.classList.add('opacity-0', 'scale-x-0');
        lineBot.classList.remove('w-4');
        lineBot.classList.add('w-6', '-translate-y-[7px]', '-rotate-45');
      } else {
        lineTop.classList.remove('translate-y-[7px]', 'rotate-45');
        lineMid.classList.remove('opacity-0', 'scale-x-0');
        lineBot.classList.remove('w-6', '-translate-y-[7px]', '-rotate-45');
        lineBot.classList.add('w-4');
      }
    }

    // Toggle Sidebar Slide-in
    if (sidebar) {
      if (open) {
        sidebar.classList.remove('translate-x-full');
        sidebar.classList.add('translate-x-0');
      } else {
        sidebar.classList.remove('translate-x-0');
        sidebar.classList.add('translate-x-full');
      }
    }

    // Toggle Backdrop Fade-in
    if (backdrop) {
      if (open) {
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
      } else {
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
        backdrop.classList.add('opacity-0', 'pointer-events-none');
      }
    }
  }

  toggleBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    setMenuState(!isMenuOpen);
  });

  closeBtn?.addEventListener('click', () => {
    setMenuState(false);
  });

  backdrop?.addEventListener('click', () => {
    setMenuState(false);
  });

  // Close when clicking nav links
  mobileNavLinks.forEach((link) => {
    link.addEventListener('click', () => {
      setMenuState(false);
    });
  });

  // Close on Escape key press
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen) {
      setMenuState(false);
    }
  });
</script>
