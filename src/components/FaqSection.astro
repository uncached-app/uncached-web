---
import { faqs } from '../data/faqs';
---

<section id="faq" class="container scroll-mt-16 pb-24">
  <h2 class="text-center text-3xl font-bold tracking-[-0.04em] text-text-primary sm:text-4xl">Questions before you install</h2>
  <div class="mt-10 grid gap-x-12 md:grid-cols-2">
    {faqs.map((faq) => (
      <div class="border-t border-border-theme py-6">
        <h3 class="text-sm font-semibold leading-snug text-text-primary">{faq.question}</h3>
        <p class="mt-2 text-sm leading-6 text-text-muted">{faq.answer}</p>
      </div>
    ))}
  </div>
</section>
