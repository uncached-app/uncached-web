# Brevo API Configuration
# Get your API key from Brevo: Account > API Keys
BREVO_API_KEY=your_brevo_api_key_here

# Optional: Brevo Contact List ID to automatically add signups to a specific list
BREVO_LIST_ID=1

# Optional: Sender configuration for transactional emails (Must be verified in Brevo)
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Uncached

# Optional: Admin email to receive notifications on new whitelist signups
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

