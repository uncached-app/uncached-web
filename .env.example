# Brevo API Configuration
# Get your API key from Brevo: Account > API Keys
BREVO_API_KEY=your_brevo_api_key_here

# Optional: Brevo Contact List ID to automatically add signups to a specific list
BREVO_LIST_ID=1

# Optional: Sender configuration for transactional emails (Must be verified in Brevo)
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Uncached

# Optional: Admin email to receive notifications on new whitelist signups
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com

# Paddle Billing (licence issuing webhook)
# Secret key of the notification destination: Paddle > Developer tools > Notifications
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your_secret_here

# API key with the customer.read scope. The pdl_sdbx_ prefix selects the sandbox host.
PADDLE_API_KEY=pdl_live_apikey_your_key_here

# 64 hex characters. Same seed as `cargo run --example license -- keygen`.
# In production this is a Cloudflare secret, never a var.
LICENSE_SIGNING_SEED=your_64_character_hex_seed_here


# Gates. Absent or anything but "true" keeps the gate closed, so a missing
# variable never opens downloads or checkout by accident. Build-time, like the
# PUBLIC_ vars below.
PUBLIC_DOWNLOADS_ENABLED=false
PUBLIC_CHECKOUT_ENABLED=false

# Paddle checkout (pricing page). PUBLIC_ vars are inlined into the built page,
# so these must be set in the Cloudflare build environment, not as secrets.
# Client-side token: Paddle > Developer tools > Authentication. A test_ prefix
# selects the sandbox checkout; live_ selects production.
PUBLIC_PADDLE_CLIENT_TOKEN=live_your_client_side_token_here
PUBLIC_PADDLE_PRICE_ANNUAL=pri_your_annual_price_id_here
PUBLIC_PADDLE_PRICE_LIFETIME=pri_your_lifetime_price_id_here
